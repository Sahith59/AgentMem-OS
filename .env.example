# AgentMem OS — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# --- Optional: Free fallback LLM (Groq) ---
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# --- Optional: only needed for benchmarks/qa_accuracy_eval.py ---
# Deliberately OpenAI, not Claude, for the QA-accuracy generator+judge —
# matches Mem0's own published methodology and avoids AgentMem OS's own
# model (Claude) judging its own answers. Costs real money when used;
# always start with --n 20-30 (~$0.30-0.50) before a full run.
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# --- Optional: cross-lingual entity aliasing ---
# Needs: pip install -e ".[multilingual]"  (pulls torch — optional on purpose).
# On by default when installed; set to 0 to disable.
# AGENTMEM_OS_CROSS_LINGUAL=1
# τ — 0.90 is the measured F1-optimal (benchmarks/cross_lingual_kg_eval_results.json);
# 0.95 = zero measured false positives at much lower recall.
# AGENTMEM_OS_CROSS_LINGUAL_TAU=0.90

# --- Optional: Local embeddings via Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Redis (default: local) ---
REDIS_URL=redis://localhost:6379
